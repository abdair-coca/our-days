# Required for the real private flow. Without them, the local demo remains available.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional modern public-key alternative. The adapter prefers this when set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional public origin used when generating invite links outside a browser request.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reserved for server-only administration tasks. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
