# Optional during Phase 0. Demo pages never read these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional modern public-key alternative. The adapter prefers this when set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional and server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
